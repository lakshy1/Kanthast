# Kanthast School frontend. Nothing is required: in dev the API goes through the
# Vite proxy to the local School backend, and in production to kanthast.in/school/api.
# Optional override to use a remote School backend instead:
# VITE_API_BASE_URL=https://kanthast.in/school/api/v1
# Public URL of this site, used for canonical links and structured data.
# VITE_SITE_URL=https://kanthast.in/school
