{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/professional/api/:path*", "destination": "https://kanthast-professional-api.vercel.app/api/:path*" },
    { "source": "/school/api/:path*", "destination": "https://kanthast-school-api.vercel.app/api/:path*" },
    { "source": "/professional", "destination": "https://kanthast-professional.vercel.app/professional/" },
    { "source": "/professional/:path*", "destination": "https://kanthast-professional.vercel.app/professional/:path*" },
    { "source": "/school", "destination": "https://kanthast-school.vercel.app/school/" },
    { "source": "/school/:path*", "destination": "https://kanthast-school.vercel.app/school/:path*" }
  ],
  "redirects": [
    { "source": "/:path(courses|pricing|login|signup|dashboard|profile|settings|lists|library|summary|video|images|chatbot|subscription|admin|adminlogin|about|contact|terms|privacy|refunds)", "destination": "/professional/:path", "permanent": false }
  ]
}
