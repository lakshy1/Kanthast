# Kanthast Professional frontend. Nothing is required: in dev the API goes through the
# Vite proxy to the local Professional backend, and in production to kanthast.in/professional/api.
# Optional override to use a remote Professional backend instead:
# VITE_API_BASE_URL=https://kanthast.in/professional/api/v1
# Public URL of this site, used for canonical links and structured data.
# VITE_SITE_URL=https://kanthast.in/professional
